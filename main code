from datetime import datetime

# Store all appointments
appointments = {}

# Starting appointment ID
next_appointment_number = 101

# Clinic timings
CLINIC_START = "09:00"
CLINIC_END = "16:30"


def generate_appointment_id():
    """Generate a new appointment ID such as A101, A102, A103."""
    global next_appointment_number

    appointment_id = f"A{next_appointment_number}"
    next_appointment_number += 1

    return appointment_id


def validate_date(date):
    """Check whether the date follows DD-MM-YYYY format."""
    try:
        appointment_date = datetime.strptime(date, "%d-%m-%Y")

        if appointment_date.date() < datetime.now().date():
            print("Error: Appointment date cannot be in the past.")
            return False

        return True

    except ValueError:
        print("Error: Invalid date format.")
        print("Please use DD-MM-YYYY.")
        return False


def validate_time(time):
    """Check whether the time follows HH:MM format and is within clinic hours."""
    try:
        appointment_time = datetime.strptime(time, "%H:%M").time()
        start_time = datetime.strptime(CLINIC_START, "%H:%M").time()
        end_time = datetime.strptime(CLINIC_END, "%H:%M").time()

        if appointment_time < start_time or appointment_time > end_time:
            print(
                f"Error: Appointment time must be between "
                f"{CLINIC_START} and {CLINIC_END}."
            )
            return False

        # Check that appointments are on 30-minute intervals
        if appointment_time.minute not in [0, 30]:
            print("Error: Appointment time must be in 30-minute intervals.")
            print("Example: 09:00, 09:30, 10:00, 10:30")
            return False

        return True

    except ValueError:
        print("Error: Invalid time format.")
        print("Please use HH:MM.")
        return False


def doctor_slot_available(doctor_name, date, time, exclude_id=None):
    """Check whether a doctor already has an appointment at the selected slot."""

    for appointment_id, appointment in appointments.items():

        if appointment_id == exclude_id:
            continue

        if (
            appointment["doctor_name"].lower() == doctor_name.lower()
            and appointment["date"] == date
            and appointment["time"] == time
        ):
            return False

    return True


def book_appointment():
    """Book a new appointment."""

    print("\n========== BOOK APPOINTMENT ==========")

    patient_name = input("Enter patient name: ").strip()

    if not patient_name:
        print("Error: Patient name cannot be empty.")
        return

    doctor_name = input("Enter doctor name: ").strip()

    if not doctor_name:
        print("Error: Doctor name cannot be empty.")
        return

    # Get and validate date
    while True:
        date = input("Enter appointment date (DD-MM-YYYY): ").strip()

        if validate_date(date):
            break

    # Get and validate time
    while True:
        time = input("Enter appointment time (HH:MM): ").strip()

        if validate_time(time):
            break

    # Check doctor availability
    if not doctor_slot_available(doctor_name, date, time):
        print("\nAppointment cannot be booked.")
        print("The doctor already has an appointment at this date and time.")
        return

    # Generate appointment ID
    appointment_id = generate_appointment_id()

    # Store appointment
    appointments[appointment_id] = {
        "patient_name": patient_name,
        "doctor_name": doctor_name,
        "date": date,
        "time": time
    }

    print("\n======================================")
    print("Appointment booked successfully!")
    print(f"Appointment ID : {appointment_id}")
    print(f"Patient Name   : {patient_name}")
    print(f"Doctor Name    : {doctor_name}")
    print(f"Date           : {date}")
    print(f"Time           : {time}")
    print("======================================")


def view_appointments():
    """Display all appointments."""

    print("\n========== VIEW APPOINTMENTS ==========")

    if not appointments:
        print("No appointments found.")
        return

    for appointment_id, appointment in appointments.items():
        print("\n--------------------------------------")
        print(f"Appointment ID : {appointment_id}")
        print(f"Patient Name   : {appointment['patient_name']}")
        print(f"Doctor Name    : {appointment['doctor_name']}")
        print(f"Date           : {appointment['date']}")
        print(f"Time           : {appointment['time']}")
        print("--------------------------------------")


def reschedule_appointment():
    """Reschedule an existing appointment."""

    print("\n========== RESCHEDULE APPOINTMENT ==========")

    if not appointments:
        print("No appointments available to reschedule.")
        return

    appointment_id = input("Enter appointment ID: ").strip().upper()

    if appointment_id not in appointments:
        print("Error: Appointment ID not found.")
        return

    appointment = appointments[appointment_id]

    print("\nCurrent Appointment Details")
    print("--------------------------------------")
    print(f"Patient : {appointment['patient_name']}")
    print(f"Doctor  : {appointment['doctor_name']}")
    print(f"Date    : {appointment['date']}")
    print(f"Time    : {appointment['time']}")

    # New date
    while True:
        new_date = input("\nEnter new date (DD-MM-YYYY): ").strip()

        if validate_date(new_date):
            break

    # New time
    while True:
        new_time = input("Enter new time (HH:MM): ").strip()

        if validate_time(new_time):
            break

    # Check doctor availability
    if not doctor_slot_available(
        appointment["doctor_name"],
        new_date,
        new_time,
        exclude_id=appointment_id
    ):
        print("\nRescheduling failed.")
        print("The doctor already has an appointment at this date and time.")
        return

    # Update appointment
    appointment["date"] = new_date
    appointment["time"] = new_time

    print("\nAppointment rescheduled successfully!")


def cancel_appointment():
    """Cancel an existing appointment."""

    print("\n========== CANCEL APPOINTMENT ==========")

    if not appointments:
        print("No appointments available to cancel.")
        return

    appointment_id = input("Enter appointment ID: ").strip().upper()

    if appointment_id not in appointments:
        print("Error: Appointment ID not found.")
        return

    appointment = appointments[appointment_id]

    print("\nAppointment Details")
    print("--------------------------------------")
    print(f"Patient : {appointment['patient_name']}")
    print(f"Doctor  : {appointment['doctor_name']}")
    print(f"Date    : {appointment['date']}")
    print(f"Time    : {appointment['time']}")

    confirmation = input("\nAre you sure you want to cancel? (Y/N): ").strip().upper()

    if confirmation == "Y":
        del appointments[appointment_id]
        print("\nAppointment cancelled successfully.")
    else:
        print("\nCancellation aborted.")


def display_menu():
    """Display the main menu."""

    print("\n")
    print("==============================================")
    print("       HOSPITAL APPOINTMENT SCHEDULER")
    print("==============================================")
    print("1. Book Appointment")
    print("2. View Appointments")
    print("3. Reschedule Appointment")
    print("4. Cancel Appointment")
    print("5. Exit")
    print("==============================================")


def main():
    """Main program."""

    print("\nWelcome to Hospital Appointment Scheduler")

    while True:

        display_menu()

        choice = input("Enter your choice (1-5): ").strip()

        if choice == "1":
            book_appointment()

        elif choice == "2":
            view_appointments()

        elif choice == "3":
            reschedule_appointment()

        elif choice == "4":
            cancel_appointment()

        elif choice == "5":
            print("\nThank you for using Hospital Appointment Scheduler.")
            print("Goodbye!")
            break

        else:
            print("\nInvalid choice.")
            print("Please enter a number between 1 and 5.")


# Start the program
if __name__ == "__main__":
    main()
